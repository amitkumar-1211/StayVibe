<header class="bg-linear-to-r from-red-500 to-rose-600 text-white shadow-lg shadow-red-900/10">
  <nav aria-label="Main navigation" class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-3 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-2 rounded-lg px-2 py-1 text-lg font-bold tracking-tight transition hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/80 <%= currentPage === 'index' ? 'bg-white/15' : '' %>">
      <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-6v-7h-4v7H4a1 1 0 0 1-1-1V10Z"/></svg>
      <span>StayVibe</span>
    </a>

    <ul class="flex w-full flex-wrap items-center justify-start gap-1 sm:w-auto sm:flex-1 sm:justify-end sm:gap-2">
      <% if (isLoggedIn) { %>
        <li><a href="/homes" aria-current="<%= currentPage === 'Home' ? 'page' : 'false' %>" class="flex items-center gap-2 whitespace-nowrap rounded-lg px-3 py-2 text-sm font-medium transition hover:bg-white hover:text-red-600 focus:outline-none focus:ring-2 focus:ring-white/80 <%= currentPage === 'Home' ? 'bg-white/15' : '' %>"><svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-6v-7h-4v7H4a1 1 0 0 1-1-1V10Z"/></svg><span>Homes-List</span></a></li>
        <li><a href="/favourites" aria-current="<%= currentPage === 'favourites' ? 'page' : 'false' %>" class="flex items-center gap-2 whitespace-nowrap rounded-lg px-3 py-2 text-sm font-medium transition hover:bg-white hover:text-red-600 focus:outline-none focus:ring-2 focus:ring-white/80 <%= currentPage === 'favourites' ? 'bg-white/15' : '' %>"><svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"/></svg><span>Favourites</span></a></li>
        <li><a href="/bookings" aria-current="<%= currentPage === 'bookings' ? 'page' : 'false' %>" class="flex items-center gap-2 whitespace-nowrap rounded-lg px-3 py-2 text-sm font-medium transition hover:bg-white hover:text-red-600 focus:outline-none focus:ring-2 focus:ring-white/80 <%= currentPage === 'bookings' ? 'bg-white/15' : '' %>"><svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path stroke-linecap="round" d="M16 3v4M8 3v4M3 10h18"/></svg><span>Bookings</span></a></li>
        <li><a href="/host/host-home-list" aria-current="<%= currentPage === 'host-homes' ? 'page' : 'false' %>" class="flex items-center gap-2 whitespace-nowrap rounded-lg px-3 py-2 text-sm font-medium transition hover:bg-white hover:text-red-600 focus:outline-none focus:ring-2 focus:ring-white/80 <%= currentPage === 'host-homes' ? 'bg-white/15' : '' %>"><svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 21V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v16M3 21h18M8 7h2m4 0h2m-8 4h2m4 0h2m-8 4h2m4 0h2"/></svg><span>Host Homes</span></a></li>
        <li><a href="/host/add-home" aria-current="<%= currentPage === 'addHome' ? 'page' : 'false' %>" class="flex items-center gap-2 whitespace-nowrap rounded-lg bg-white/15 px-3 py-2 text-sm font-semibold text-white transition hover:bg-white hover:text-red-600 focus:outline-none focus:ring-2 focus:ring-white/80 <%= currentPage === 'addHome' ? 'ring-2 ring-white/70' : '' %>"><svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M12 5v14M5 12h14"/><rect x="3" y="3" width="18" height="18" rx="3"/></svg><span>Add Home</span></a></li>
        <li>
          <form action="/logout" method="post">
            <button type="submit" class="flex items-center gap-2 whitespace-nowrap rounded-lg px-3 py-2 text-sm font-medium transition hover:bg-white hover:text-red-600 focus:outline-none focus:ring-2 focus:ring-white/80"><svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 17l5-5-5-5m5 5H3m9-9h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-6"/></svg><span>Logout</span></button>
          </form>
        </li>
      <% } else { %>
        <li><a href="/signup" aria-current="<%= currentPage === 'signup' ? 'page' : 'false' %>" class="flex items-center gap-2 whitespace-nowrap rounded-lg px-3 py-2 text-sm font-medium transition hover:bg-white hover:text-red-600 focus:outline-none focus:ring-2 focus:ring-white/80 <%= currentPage === 'signup' ? 'bg-white/15' : '' %>"><svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2m6-10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm9-3v6m-3-3h6"/></svg><span>SignUp</span></a></li>
        <li><a href="/login" aria-current="<%= currentPage === 'Login' ? 'page' : 'false' %>" class="flex items-center gap-2 whitespace-nowrap rounded-lg bg-white px-4 py-2 text-sm font-semibold text-red-600 shadow-sm transition hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-white/80 <%= currentPage === 'Login' ? 'ring-2 ring-white/70' : '' %>"><svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 17l5-5-5-5m5 5H3m9-9h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-6"/></svg><span>Login</span></a></li>
      <% } %>
    </ul>
  </nav>
</header>
