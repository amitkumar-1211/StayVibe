<header class="bg-linear-to-r from-red-500 to-rose-600 text-white shadow-lg shadow-red-900/10">
  <nav aria-label="Main navigation" class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-3 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-2 rounded-lg px-2 py-1 text-lg font-bold tracking-tight transition hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/80">
      <span>StayVibe</span>
    </a>

    <ul class="flex w-full flex-wrap items-center justify-start gap-1 sm:w-auto sm:flex-1 sm:justify-end sm:gap-2">
      <% if (isLoggedIn) { %>
        <% if (user && user.userType === 'host') { %>
          <li><a href="/host/host-home-list" class="rounded-lg px-3 py-2 text-sm font-medium transition hover:bg-white hover:text-red-600">Host Homes</a></li>
        <% } %>
        <li><a href="/homes" class="rounded-lg px-3 py-2 text-sm font-medium transition hover:bg-white hover:text-red-600">Homes</a></li>
        <li><a href="/favourites" class="rounded-lg px-3 py-2 text-sm font-medium transition hover:bg-white hover:text-red-600">Favourites</a></li>
        <li><a href="/bookings" class="rounded-lg px-3 py-2 text-sm font-medium transition hover:bg-white hover:text-red-600">Bookings</a></li>
        <% if (user && user.userType === 'host') { %>
          <li><a href="/host/add-home" class="rounded-lg px-3 py-2 text-sm font-medium transition hover:bg-white hover:text-red-600">Add Home</a></li>
        <% } %>
        <li>
          <form action="/logout" method="post">
            <button type="submit" class="rounded-lg px-3 py-2 text-sm font-medium transition hover:bg-white hover:text-red-600">Logout</button>
          </form>
        </li>
      <% } else { %>
        <li><a href="/signup" aria-current="<%= currentPage === 'signup' ? 'page' : 'false' %>" class="rounded-lg px-3 py-2 text-sm font-medium transition hover:bg-white hover:text-red-600">Sign Up</a></li>
        <li><a href="/login" aria-current="<%= currentPage === 'login' ? 'page' : 'false' %>" class="rounded-lg bg-white px-4 py-2 text-sm font-semibold text-red-600 shadow-sm transition hover:bg-red-50">Login</a></li>
      <% } %>
    </ul>
  </nav>
</header>
