<%- include('../partials/head') %>
  </head>
  <body class="min-h-screen bg-gray-100 text-gray-800">
    <%- include('../partials/nav') %>

    <main class="mx-auto flex min-h-[calc(100vh-64px)] items-start justify-center px-4 py-8 sm:py-10">
      <section class="w-full max-w-sm rounded-sm bg-white px-6 py-6 shadow-md sm:px-8">
        <h1 class="mb-5 border-b border-gray-200 pb-4 text-center text-2xl font-bold text-gray-900">Create Your Account</h1>

        <form action="/signup" method="POST" class="space-y-3.5">
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="firstName" class="mb-1 block text-xs font-medium text-gray-700">First Name</label>
              <div class="flex items-center rounded border border-gray-300 px-2.5 focus-within:border-red-500 focus-within:ring-1 focus-within:ring-red-500">
                <svg aria-hidden="true" class="h-4 w-4 shrink-0 text-gray-400" viewBox="0 0 20 20" fill="currentColor"><path d="M10 10a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM3 17a7 7 0 0 1 14 0H3Z"/></svg>
                <input id="firstName" type="text" name="firstName" placeholder="John" autocomplete="given-name" required class="w-full border-0 bg-transparent px-2 py-2 text-sm outline-none placeholder:text-gray-400" />
              </div>
            </div>
            <div>
              <label for="lastName" class="mb-1 block text-xs font-medium text-gray-700">Last Name</label>
              <div class="flex items-center rounded border border-gray-300 px-2.5 focus-within:border-red-500 focus-within:ring-1 focus-within:ring-red-500">
                <svg aria-hidden="true" class="h-4 w-4 shrink-0 text-gray-400" viewBox="0 0 20 20" fill="currentColor"><path d="M10 10a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM3 17a7 7 0 0 1 14 0H3Z"/></svg>
                <input id="lastName" type="text" name="lastName" placeholder="Doe" autocomplete="family-name" class="w-full border-0 bg-transparent px-2 py-2 text-sm outline-none placeholder:text-gray-400" />
              </div>
            </div>
          </div>

          <div>
            <label for="email" class="mb-1 block text-xs font-medium text-gray-700">Email Address</label>
            <div class="flex items-center rounded border border-gray-300 px-2.5 focus-within:border-red-500 focus-within:ring-1 focus-within:ring-red-500">
              <svg aria-hidden="true" class="h-4 w-4 shrink-0 text-gray-400" viewBox="0 0 20 20" fill="currentColor"><path d="M2.5 5A2.5 2.5 0 0 1 5 2.5h10A2.5 2.5 0 0 1 17.5 5v.4l-7.5 4.8-7.5-4.8V5Zm0 2.2v7.8A2.5 2.5 0 0 0 5 17.5h10a2.5 2.5 0 0 0 2.5-2.5V7.2l-6.9 4.4a1.1 1.1 0 0 1-1.2 0L2.5 7.2Z"/></svg>
              <input id="email" type="email" name="email" placeholder="your.email@example.com" autocomplete="email" required class="w-full border-0 bg-transparent px-2 py-2 text-sm outline-none placeholder:text-gray-400" />
            </div>
          </div>

          <div>
            <div>
              <label for="password" class="mb-1 block text-xs font-medium text-gray-700">Password</label>
              <div class="flex items-center rounded border border-gray-300 px-2.5 focus-within:border-red-500 focus-within:ring-1 focus-within:ring-red-500">
                <svg aria-hidden="true" class="h-4 w-4 shrink-0 text-gray-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5 8V6a5 5 0 0 1 10 0v2h.5A1.5 1.5 0 0 1 17 9.5v7a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 3 16.5v-7A1.5 1.5 0 0 1 4.5 8H5Zm2 0h6V6a3 3 0 0 0-6 0v2Z" clip-rule="evenodd"/></svg>
                <input id="password" type="password" name="password" placeholder="Enter Your Password" autocomplete="new-password" required class="w-full border-0 bg-transparent px-2 py-2 text-sm outline-none placeholder:text-gray-400" />
              </div>
            </div>
            <div>
              <label for="confirmPassword" class="mb-1 mt-3 block text-xs font-medium text-gray-700">Confirm Password</label>
              <div class="flex items-center rounded border border-gray-300 px-2.5 focus-within:border-red-500 focus-within:ring-1 focus-within:ring-red-500">
                <svg aria-hidden="true" class="h-4 w-4 shrink-0 text-gray-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5 8V6a5 5 0 0 1 10 0v2h.5A1.5 1.5 0 0 1 17 9.5v7a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 3 16.5v-7A1.5 1.5 0 0 1 4.5 8H5Zm2 0h6V6a3 3 0 0 0-6 0v2Z" clip-rule="evenodd"/></svg>
                <input id="confirmPassword" type="password" name="confirmPassword" placeholder="Confirm Your Password" autocomplete="new-password" required class="w-full border-0 bg-transparent px-2 py-2 text-sm outline-none placeholder:text-gray-400" />
              </div>
            </div>
          </div>

          <fieldset class="rounded border border-gray-200 bg-gray-50 px-3 py-2.5">
            <legend class="px-1 text-xs font-medium text-gray-700">I want to register as:</legend>
            <div class="flex gap-5 text-sm">
              <label for="guest" class="flex cursor-pointer items-center gap-1.5"><input type="radio" name="userType" value="guest" id="guest" class="accent-blue-600" checked /> Guest</label>
              <label for="host" class="flex cursor-pointer items-center gap-1.5"><input type="radio" name="userType" value="host" id="host" class="accent-blue-600" /> Host</label>
            </div>
          </fieldset>

          <label for="terms" class="flex cursor-pointer items-center gap-2 text-xs text-gray-700">
            <input type="checkbox" name="terms" id="terms" required class="h-4 w-4 accent-red-500" />
            <span>I agree to the <a href="#" class="font-medium text-red-500 hover:text-red-700">terms and conditions</a></span>
          </label>

          <button type="submit" class="flex w-full items-center justify-center gap-2 rounded bg-red-500 px-5 py-3 text-sm font-semibold text-white transition hover:bg-red-600 focus:outline-none focus:ring-4 focus:ring-red-200">
            Register <span aria-hidden="true">→</span>
          </button>

          <p class="text-center text-xs text-gray-600">Already have an account? <a href="/Login" class="font-medium text-red-500 hover:text-red-700">Log in</a></p>
        </form>
      </section>
    </main>
  </body>
</html>
